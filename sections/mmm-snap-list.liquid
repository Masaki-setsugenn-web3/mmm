{%- liquid
  assign all_snaps     = shop.metaobjects.staffsnap.values
  assign items_per_page = section.settings.items_per_page | default: 24
  assign all_staff     = shop.metaobjects.staff.values
-%}

{%- style -%}
  .mmm-sl { width: 100%; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  .mmm-sl__inner { max-width: 1200px; margin: 0 auto; padding: 0 32px; }
  .mmm-sl__heading { text-align: center; font-size: 22px; font-weight: 600; margin: 0 0 36px; letter-spacing: 0.04em; }

  /* ── スタッフナビ ── */
  .mmm-sl__staff-nav {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    padding-bottom: 4px;
    margin-bottom: 48px;
    scrollbar-width: none;
    justify-content: center;
    flex-wrap: wrap;
  }
  .mmm-sl__staff-nav::-webkit-scrollbar { display: none; }

  .mmm-sl__staff-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  .mmm-sl__staff-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    border: 2px solid transparent;
    transition: border-color 0.25s;
  }
  .mmm-sl__staff-item:hover .mmm-sl__staff-avatar {
    border-color: rgb(var(--color-base-text));
  }

  .mmm-sl__staff-avatar--placeholder {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(var(--color-base-text), 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: 600;
    border: 2px solid transparent;
    transition: border-color 0.25s;
  }
  .mmm-sl__staff-item:hover .mmm-sl__staff-avatar--placeholder {
    border-color: rgb(var(--color-base-text));
  }

  .mmm-sl__staff-name {
    font-size: 11px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* ── グリッド ── */
  .mmm-sl__grid {
    display: grid;
    gap: 32px;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
  }
  @media (max-width: 989px) { .mmm-sl__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px)  { .mmm-sl__grid { grid-template-columns: 1fr; } }

  .mmm-sl__item {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .mmm-sl__item:hover .mmm-sl__item-img { transform: scale(1.03); }

  .mmm-sl__item-img-wrap {
    width: 100%;
    aspect-ratio: 3 / 4;
    background: #f0f0f0;
    margin-bottom: 10px;
    overflow: hidden;
  }

  .mmm-sl__item-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s;
  }

  .mmm-sl__item-name { font-size: 14px; font-weight: 600; margin: 0 0 4px; }
  .mmm-sl__item-meta { font-size: 12px; opacity: 0.6; display: flex; justify-content: space-between; }

  @media (prefers-reduced-motion: reduce) {
    .mmm-sl__staff-avatar,
    .mmm-sl__staff-avatar--placeholder { transition: none; }
    .mmm-sl__item-img { transition: none; }
    .mmm-sl__item:hover .mmm-sl__item-img { transform: none; }
  }
{%- endstyle -%}

<div class="mmm-sl">
  <div class="mmm-sl__inner">

    {%- if section.settings.heading != blank -%}
      <h2 class="mmm-sl__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if all_staff.size > 0 -%}
      <nav class="mmm-sl__staff-nav" aria-label="スタッフ一覧">
        {%- for member in all_staff -%}
          <a href="{{ member.system.url }}" class="mmm-sl__staff-item">
            {%- if member.profile_photo != blank -%}
              {{ member.profile_photo | image_url: width: 130 | image_tag:
                class: 'mmm-sl__staff-avatar',
                loading: 'lazy',
                alt: member.name | escape
              }}
            {%- else -%}
              <span class="mmm-sl__staff-avatar--placeholder" aria-hidden="true">
                {{- member.name | slice: 0, 1 | upcase -}}
              </span>
            {%- endif -%}
            <span class="mmm-sl__staff-name">{{ member.name }}</span>
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <div class="mmm-sl__grid">
      {%- for snap in all_snaps limit: items_per_page -%}
        {%- if snap.snap_image == blank -%}{%- continue -%}{%- endif -%}
        {%- assign snap_img = snap.snap_image.value | first -%}
        <a href="{{ snap.system.url }}" class="mmm-sl__item">
          <div class="mmm-sl__item-img-wrap">
            {{ snap_img | image_url: width: 600 | image_tag:
              loading: 'lazy',
              class: 'mmm-sl__item-img',
              alt: snap.staff_ref.value.name | escape
            }}
          </div>
          <div class="mmm-sl__item-info">
            <p class="mmm-sl__item-name">{{ snap.staff_ref.value.name }}</p>
            <div class="mmm-sl__item-meta">
              <span>{{ snap.post_date | date: "%Y.%m.%d" }}</span>
              <span>{{ snap.staff_ref.value.height }}cm</span>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Staff Snap List",
  "tag": "section",
  "settings": [
    { "type": "text",  "id": "heading",        "label": "見出し",      "default": "STAFF SNAP LIST" },
    { "type": "range", "id": "items_per_page",  "label": "表示件数",    "min": 12, "max": 60, "step": 12, "default": 24 },
    { "type": "range", "id": "columns_desktop", "label": "列数(PC)",    "min": 2,  "max": 5,             "default": 3 },
    { "type": "text",  "id": "empty_message",   "label": "空メッセージ", "default": "投稿がありません" },
    { "type": "range", "id": "padding_top",     "min": 0, "max": 100, "default": 36, "label": "上部余白" },
    { "type": "range", "id": "padding_bottom",  "min": 0, "max": 100, "default": 36, "label": "下部余白" }
  ],
  "presets": [{ "name": "Staff Snap List" }]
}
{% endschema %}
