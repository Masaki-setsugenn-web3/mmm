{%- liquid
  assign columns    = section.settings.columns_desktop | default: 3
  assign col_mobile = section.settings.columns_mobile  | default: 2
  assign per_page   = section.settings.per_page        | default: 24
-%}

<div class="mmm-vc-root">

  {%- comment -%} Full-bleed inverted header {%- endcomment -%}
  <div class="mmm-vc-masthead">
    <div class="mmm-vc-masthead__inner page-width">
      <p class="mmm-vc-masthead__eyebrow">{{ section.settings.eyebrow | default: 'Archive' }}</p>
      <h1 class="mmm-vc-masthead__title">
        {%- if section.settings.custom_title != blank -%}
          {{ section.settings.custom_title }}
        {%- else -%}
          {{ collection.title }}
        {%- endif -%}
      </h1>
      {%- if section.settings.show_description and collection.description != blank -%}
        <p class="mmm-vc-masthead__desc">{{ collection.description | strip_html | truncate: 180 }}</p>
      {%- endif -%}
      <p class="mmm-vc-masthead__count">{{ collection.products_count }}&thinsp;pieces</p>
    </div>
  </div>

  {%- comment -%} Filter bar {%- endcomment -%}
  {%- if section.settings.show_brand_filter -%}
    {%- assign all_vendors = collection.all_vendors -%}
    {%- if all_vendors.size > 0 -%}
      <nav class="mmm-vc-filter page-width" aria-label="ブランドで絞り込む">
        <div class="mmm-vc-filter__row">
          <button class="mmm-vc-filter__pill is-active" data-vc-filter="">
            {{ section.settings.filter_all_label | default: 'All' }}
          </button>
          {%- for vendor in all_vendors -%}
            <button class="mmm-vc-filter__pill" data-vc-filter="{{ vendor | escape }}">
              {{ vendor }}
            </button>
          {%- endfor -%}
        </div>
      </nav>
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} Catalog grid {%- endcomment -%}
  {%- paginate collection.products by per_page -%}
    <div
      class="mmm-vc-grid"
      id="mmm-vc-grid"
      style="--cols: {{ columns }}; --cols-m: {{ col_mobile }};"
    >
      {%- for product in collection.products -%}
        <article class="mmm-vc-card" data-vendor="{{ product.vendor | escape }}">
          <a
            class="mmm-vc-card__a"
            href="{{ product.url }}?variant={{ product.first_available_variant.id }}"
            tabindex="0"
          >
            {%- comment -%} Image {%- endcomment -%}
            <div class="mmm-vc-card__fig">
              {%- if product.featured_image != blank -%}
                <img
                  class="mmm-vc-card__img mmm-vc-card__img--primary"
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  width="800" height="1200"
                  loading="lazy"
                >
                {%- if product.images.size > 1 -%}
                  <img
                    class="mmm-vc-card__img mmm-vc-card__img--alt"
                    src="{{ product.images[1] | image_url: width: 800 }}"
                    alt="{{ product.images[1].alt | default: product.title | escape }}"
                    width="800" height="1200"
                    loading="lazy"
                  >
                {%- endif -%}
              {%- else -%}
                <div class="mmm-vc-card__noimg">—</div>
              {%- endif -%}

              {%- unless product.available -%}
                <span class="mmm-vc-card__sold">Sold</span>
              {%- endunless -%}

              {%- comment -%} Hover overlay {%- endcomment -%}
              <div class="mmm-vc-card__veil" aria-hidden="true">
                <span class="mmm-vc-card__veil-brand">{{ product.vendor }}</span>
                <span class="mmm-vc-card__veil-title">{{ product.title }}</span>
                <span class="mmm-vc-card__veil-price">{{ product.price | money }}</span>
              </div>
            </div>

            {%- comment -%} Caption strip {%- endcomment -%}
            <div class="mmm-vc-card__cap">
              <span class="mmm-vc-card__cap-vendor">{{ product.vendor }}</span>
              <span class="mmm-vc-card__cap-price">{{ product.price | money }}</span>
            </div>
          </a>
        </article>
      {%- else -%}
        <p class="mmm-vc-empty">{{ section.settings.empty_label | default: 'No items found.' }}</p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="mmm-vc-pager page-width" aria-label="ページ">
        {%- if paginate.previous -%}
          <a class="mmm-vc-pager__a" href="{{ paginate.previous.url }}">← Previous</a>
        {%- endif -%}
        <span class="mmm-vc-pager__info">{{ paginate.current_page }} / {{ paginate.pages }}</span>
        {%- if paginate.next -%}
          <a class="mmm-vc-pager__a" href="{{ paginate.next.url }}">Next →</a>
        {%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}

</div>

{% style %}
/* ============================================================
   Vintage Archive — Collection  /  SP-first
   ============================================================ */

/* ── Masthead (inverted) ── */
.mmm-vc-masthead {
  background: rgb(var(--color-base-text));
  color: rgb(var(--color-base-background-1));
  padding: 48px 0 36px;
}
.mmm-vc-masthead__inner {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0;
}
.mmm-vc-masthead__eyebrow {
  font-size: 0.58rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  opacity: 0.45;
  margin: 0 0 20px;
}
.mmm-vc-masthead__title {
  font-size: clamp(2rem, 8vw, 4.5rem);
  font-weight: 300;
  letter-spacing: -0.01em;
  line-height: 1;
  margin: 0 0 24px;
  color: inherit;
}
.mmm-vc-masthead__desc {
  font-size: 0.8rem;
  line-height: 1.7;
  opacity: 0.55;
  margin: 0 0 20px;
  max-width: 48ch;
}
.mmm-vc-masthead__count {
  font-size: 0.58rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  opacity: 0.35;
  margin: 0;
}

/* ── Filter bar ── */
.mmm-vc-filter {
  padding: 20px 0;
  border-bottom: 1px solid rgba(var(--color-base-text), 0.1);
}
.mmm-vc-filter__row {
  display: flex;
  align-items: center;
  gap: 0;
  overflow-x: auto;
  scrollbar-width: none;
}
.mmm-vc-filter__row::-webkit-scrollbar { display: none; }

.mmm-vc-filter__pill {
  flex-shrink: 0;
  background: none;
  border: none;
  font-size: 0.6rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(var(--color-base-text), 0.4);
  padding: 6px 16px 6px 0;
  cursor: pointer;
  position: relative;
  min-height: 44px;
  white-space: nowrap;
}
.mmm-vc-filter__pill::after {
  content: '';
  display: block;
  height: 1px;
  background: rgb(var(--color-base-text));
  position: absolute;
  bottom: 4px;
  left: 0;
  right: 16px;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.2s ease;
}
.mmm-vc-filter__pill.is-active {
  color: rgb(var(--color-base-text));
}
.mmm-vc-filter__pill.is-active::after,
.mmm-vc-filter__pill:hover::after {
  transform: scaleX(1);
}

/* ── Catalog grid — architectural 1px lines ── */
.mmm-vc-grid {
  display: grid;
  grid-template-columns: repeat(var(--cols-m, 2), 1fr);
  /* 1px borders via box-shadow trick to avoid doubling */
  border-top: 1px solid rgba(var(--color-base-text), 0.12);
  border-left: 1px solid rgba(var(--color-base-text), 0.12);
}

/* ── Card ── */
.mmm-vc-card {
  border-right: 1px solid rgba(var(--color-base-text), 0.12);
  border-bottom: 1px solid rgba(var(--color-base-text), 0.12);
}
.mmm-vc-card[hidden] { display: none; }

.mmm-vc-card__a {
  display: block;
  text-decoration: none;
  color: inherit;
}

/* Image */
.mmm-vc-card__fig {
  position: relative;
  aspect-ratio: 2 / 3;
  overflow: hidden;
  background: rgba(var(--color-base-text), 0.03);
}
.mmm-vc-card__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.mmm-vc-card__img--alt { display: none; } /* SP: no hover */

.mmm-vc-card__noimg {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  color: rgba(var(--color-base-text), 0.15);
}

.mmm-vc-card__sold {
  position: absolute;
  top: 10px;
  left: 10px;
  font-size: 0.55rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  background: rgb(var(--color-base-background-1));
  color: rgba(var(--color-base-text), 0.5);
  padding: 3px 8px;
}

/* Hover veil — hidden on SP */
.mmm-vc-card__veil { display: none; }

/* Caption strip */
.mmm-vc-card__cap {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px;
  padding: 9px 10px 12px;
}
.mmm-vc-card__cap-vendor {
  font-size: 0.55rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(var(--color-base-text), 0.45);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.mmm-vc-card__cap-price {
  font-size: 0.7rem;
  color: rgb(var(--color-base-text));
  flex-shrink: 0;
}

/* Empty */
.mmm-vc-empty {
  grid-column: 1 / -1;
  text-align: center;
  padding: 80px 0;
  font-size: 0.75rem;
  letter-spacing: 0.15em;
  color: rgba(var(--color-base-text), 0.35);
}

/* Pagination */
.mmm-vc-pager {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32px;
  padding: 48px 0 80px;
}
.mmm-vc-pager__a {
  font-size: 0.65rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  text-decoration: none;
  color: rgba(var(--color-base-text), 0.6);
  padding-bottom: 2px;
  border-bottom: 1px solid rgba(var(--color-base-text), 0.25);
  min-height: 44px;
  display: inline-flex;
  align-items: center;
}
.mmm-vc-pager__a:hover { color: rgb(var(--color-base-text)); border-color: rgb(var(--color-base-text)); }
.mmm-vc-pager__info {
  font-size: 0.6rem;
  letter-spacing: 0.14em;
  color: rgba(var(--color-base-text), 0.3);
}

/* ============================================================
   DESKTOP (990px+)
   ============================================================ */
@media screen and (min-width: 990px) {

  .mmm-vc-masthead { padding: 72px 0 56px; }
  .mmm-vc-masthead__inner { flex-direction: row; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; }
  .mmm-vc-masthead__eyebrow { margin-bottom: 0; order: -1; width: 100%; }
  .mmm-vc-masthead__title { margin-bottom: 0; }
  .mmm-vc-masthead__count { margin-bottom: 4px; text-align: right; }
  .mmm-vc-masthead__desc { order: 10; width: 100%; margin-top: 20px; margin-bottom: 0; }

  .mmm-vc-filter { padding: 14px 0; }
  .mmm-vc-filter__row { flex-wrap: wrap; overflow-x: unset; }

  .mmm-vc-grid {
    grid-template-columns: repeat(var(--cols, 3), 1fr);
  }

  /* Hover veil */
  .mmm-vc-card__img--alt {
    display: block;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .mmm-vc-card__img--primary {
    transition: transform 0.5s ease;
  }
  .mmm-vc-card:hover .mmm-vc-card__img--primary { transform: scale(1.04); }
  .mmm-vc-card:hover .mmm-vc-card__img--alt { opacity: 1; }

  .mmm-vc-card__veil {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.52);
    opacity: 0;
    transition: opacity 0.3s ease;
    text-align: center;
    padding: 24px;
  }
  .mmm-vc-card:hover .mmm-vc-card__veil { opacity: 1; }

  .mmm-vc-card__veil-brand {
    font-size: 0.55rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
  }
  .mmm-vc-card__veil-title {
    font-size: 1rem;
    font-weight: 300;
    letter-spacing: 0.03em;
    line-height: 1.3;
    color: #fff;
  }
  .mmm-vc-card__veil-price {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.7);
    margin-top: 4px;
  }

  .mmm-vc-card__cap { padding: 10px 14px 16px; }
}

@media (prefers-reduced-motion: reduce) {
  .mmm-vc-card__img--primary,
  .mmm-vc-card__img--alt,
  .mmm-vc-card__veil,
  .mmm-vc-filter__pill::after { transition: none; }
}
{% endstyle %}

{% javascript %}
(function () {
  'use strict';
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-vc-filter]');
    if (!btn) return;
    var vendor = btn.dataset.vcFilter;
    document.querySelectorAll('[data-vc-filter]').forEach(function (b) {
      b.classList.toggle('is-active', b === btn);
    });
    document.querySelectorAll('.mmm-vc-card').forEach(function (card) {
      card.hidden = vendor !== '' && card.dataset.vendor !== vendor;
    });
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Vintage Archive — コレクション",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "アイブロウ（小さな上見出し）",
      "default": "Archive"
    },
    {
      "type": "text",
      "id": "custom_title",
      "label": "カスタムタイトル（空でコレクション名）"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "説明文を表示",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "PC列数",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "SP列数",
      "options": [
        { "value": "1", "label": "1列" },
        { "value": "2", "label": "2列" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "1ページ件数",
      "min": 12,
      "max": 48,
      "step": 12,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_brand_filter",
      "label": "ブランドフィルターを表示",
      "default": true
    },
    {
      "type": "text",
      "id": "filter_all_label",
      "label": "「全件」ラベル",
      "default": "All"
    },
    {
      "type": "text",
      "id": "empty_label",
      "label": "商品なし時のテキスト",
      "default": "No items found."
    }
  ],
  "presets": [{ "name": "Vintage Archive — コレクション" }]
}
{% endschema %}
